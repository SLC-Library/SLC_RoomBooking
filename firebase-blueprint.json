{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "A meeting room reservation record",
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "description": "Meeting room name",
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "description": "Booking date in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "startTime": {
          "type": "string",
          "description": "Start time in HH:MM format",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "endTime": {
          "type": "string",
          "description": "End time in HH:MM format",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "department": {
          "type": "string",
          "description": "Department or faculty of booker",
          "maxLength": 150
        },
        "booker": {
          "type": "string",
          "description": "Name of booker",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 50
        },
        "purpose": {
          "type": "string",
          "description": "Purpose of booking",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Status of the booking",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 100
        }
      },
      "required": [
        "room",
        "date",
        "startTime",
        "endTime",
        "department",
        "booker",
        "purpose"
      ]
    },
    "maintenance": {
      "title": "Maintenance Slot",
      "description": "Scheduled room maintenance or closure interval",
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "description": "Meeting room name or 'ทุกห้อง'",
          "maxLength": 100
        },
        "building": {
          "type": "string",
          "description": "Building name or 'ทุกอาคาร'",
          "maxLength": 100
        },
        "startDate": {
          "type": "string",
          "description": "Start date of maintenance YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "description": "End date of maintenance YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "start": {
          "type": "string",
          "description": "Start time HH:MM",
          "maxLength": 10
        },
        "end": {
          "type": "string",
          "description": "End time HH:MM",
          "maxLength": 10
        },
        "reason": {
          "type": "string",
          "description": "Reason for maintenance or closure",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 100
        }
      },
      "required": ["room", "startDate", "endDate", "start", "end"]
    },
    "serviceHour": {
      "title": "Service Hour",
      "description": "Date-range operating hours override for a library building",
      "type": "object",
      "properties": {
        "building": {
          "type": "string",
          "description": "Library building name",
          "enum": ["Saint Louis", "Saint Benedict"]
        },
        "startDate": {
          "type": "string",
          "description": "First date of the override in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "endDate": {
          "type": "string",
          "description": "Last date of the override in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "openTime": {
          "type": "string",
          "description": "Opening time HH:MM",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "closeTime": {
          "type": "string",
          "description": "Closing time HH:MM",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable label for the special period",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 100
        }
      },
      "required": ["building", "startDate", "endDate", "openTime", "closeTime", "reason"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of room bookings"
    },
    "/maintenance/{maintenanceId}": {
      "schema": "maintenance",
      "description": "Collection of room maintenance entries"
    },
    "/serviceHours/{serviceHourId}": {
      "schema": "serviceHour",
      "description": "Collection of operating hours entries"
    }
  }
}
